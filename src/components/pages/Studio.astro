---
/**
 * Estudio: ensayo visual. El manifiesto se lee por partes, cada una acompañada
 * por una imagen del estudio (proyecto, croquis, obra), y cierra con dibujos y procesos.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../Picture.astro';
import { t, type Lang } from '../../i18n/ui';
import { routes, projectUrl, pageAlternates } from '../../i18n/routes';
import { studio, practice } from '../../i18n/pages';
import { getProjects, altFor } from '../../lib/projects';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = studio[lang];
const pr = practice[lang];
const all = await getProjects();
const byId = (id: string) => all.find((p) => p.id === id);
const conv = byId('conversatorio-fisica-cuantica');
const ceno = byId('cenotafio-elevador-5');
const groups = {
  architecture: all.filter((p) => p.data.status === 'built' || p.data.status === 'project'),
  competitions: all.filter((p) => p.data.status === 'competition' || p.data.status === 'academic'),
  visualization: all.filter((p) => p.data.status === 'visualization'),
};
const k = (key: 'photo' | 'render' | 'drawing') => t(lang, `kind.${key}`);
// croquis: solo el trazo (sin papel), se funde con el fondo de la página
const drawings = [
  { id: 'st-croquis-2', alt: s.alt.croquis2, cap: k('drawing'), ink: true },
  { id: 'st-croquis-3', alt: s.alt.croquis3, cap: k('drawing'), ink: true },
  { id: 'st-mesa', alt: s.alt.mesa, cap: s.processCaption, ink: false },
];
---

<BaseLayout lang={lang} title={s.title} description={s.description} alternates={pageAlternates('studio')} page="studio" ogImage="/og/conversatorio-fisica-cuantica.jpg">
  <section class="st-intro grid12 wrap">
    <h1 class="label">{s.title}</h1>
    <p class="st-title" data-lines>{t(lang, 'home.manifesto')}</p>
  </section>

  <section class="st-essay grid12 wrap st-right" aria-label={s.title}>
    <div class="st-text"><p data-lines set:html={s.manifesto[0]} /></div>
    {conv && (
      <figure class="st-fig st-fig-l" data-drift>
        <Picture id="conv-int" alt={altFor(conv, 'conv-int', lang)} sizes="(min-width: 1024px) 50vw, 100vw" natural />
        <figcaption class="caption"><a class="u-link" href={projectUrl(lang, conv.data.slug)}>{conv.data.title[lang]}</a><span>{k('render')}</span></figcaption>
      </figure>
    )}
  </section>

  <section class="st-essay grid12 wrap st-left">
    <figure class="st-fig st-fig-m">
      <Picture id="st-croquis-1" alt={s.alt.croquis1} sizes="(min-width: 1024px) 42vw, 100vw" class="ink" natural expose />
      <figcaption class="caption"><span>{k('drawing')}</span></figcaption>
    </figure>
    <div class="st-text"><p data-lines set:html={s.manifesto[1]} /></div>
  </section>

  <section class="st-essay grid12 wrap st-right">
    <div class="st-text"><p data-lines set:html={s.manifesto[2]} /></div>
    <figure class="st-fig st-fig-s">
      <Picture id="st-proceso" alt={s.alt.proceso} sizes="(min-width: 1024px) 34vw, 100vw" natural expose />
      <figcaption class="caption"><span>{s.processCaption}</span></figcaption>
    </figure>
  </section>

  {ceno && (
    <section class="st-wide wrap">
      <figure>
        <Picture id="ceno-obra" alt={altFor(ceno, 'ceno-obra', lang)} sizes="(min-width: 1024px) 40vw, 100vw" natural expose />
        <figcaption class="caption"><a class="u-link" href={projectUrl(lang, ceno.data.slug)}>{ceno.data.title[lang]}</a><span>{k('photo')}</span></figcaption>
      </figure>
      <figure>
        <Picture id="ceno-placas" alt={altFor(ceno, 'ceno-placas', lang)} sizes="(min-width: 1024px) 30vw, 100vw" natural expose />
        <figcaption class="caption"><span>{k('photo')}</span></figcaption>
      </figure>
    </section>
  )}

  <section class="st-process wrap" aria-labelledby="process-title">
    <div class="section-head">
      <h2 id="process-title">{s.processTitle}</h2>
    </div>
    <div class="st-strip" data-lightbox>
      {drawings.map((d) => (
        <figure>
          <button class="lb-item" type="button" data-lightbox-item aria-label={`${t(lang, 'lightbox.open')}: ${d.alt}`} aria-haspopup="dialog">
            <Picture id={d.id} alt={d.alt} sizes="(min-width: 640px) 32vw, 100vw" class={d.ink ? 'ink' : ''} expose />
          </button>
          <figcaption class="caption"><span>{d.cap}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="practice grid12 wrap" aria-labelledby="practice-title">
    <h2 class="label" id="practice-title">{pr.title}</h2>
    <div class="cols">
      {pr.groups.map((g) => (
        <div>
          <h3>{g.label}</h3>
          <ul>
            {groups[g.key].map((p) => (
              <li><a href={projectUrl(lang, p.data.slug)}>{p.data.title[lang]}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <nav class="st-close grid12 wrap" aria-label={s.title}>
    <a class="p-next" href={routes.projects[lang]}>
      <span class="label">{t(lang, 'nav.projects')}</span>
      <span class="t">{s.toProjects}</span>
    </a>
    <a class="p-next" href={routes.contact[lang]}>
      <span class="label">{t(lang, 'nav.contact')}</span>
      <span class="t">{s.toContact}</span>
    </a>
  </nav>
</BaseLayout>
