---
/**
 * Grilla editorial de la página Proyectos (con filtros por estado).
 * Proporciones y columnas según GRID_PATTERN (desktop y mobile).
 */
import ProjectCard from './ProjectCard.astro';
import type { Lang } from '../i18n/ui';
import type { Project } from '../lib/projects';
import { slotStyle } from '../lib/grid-pattern';

interface Props {
  projects: Project[];
  lang: Lang;
  id?: string;
}
const { projects, lang, id } = Astro.props;
---

<div class="pgrid" id={id} data-grid>
  {projects.map((p, i) => <ProjectCard project={p} lang={lang} style={slotStyle(i)} />)}
</div>
